{
  "name": "dsh-fresh-green-skin",
  "version": "1.6.0",
  "type": "module",
  "description": "清新白绿皮肤：4K/自定义壁纸与动态视频壁纸、壁纸取色、侧栏与气泡透光、品牌色、快捷图标条、字体与命名主题",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kiki-trouvaille/dsh-fresh-green-skin.git"
  },
  "homepage": "https://github.com/Kiki-trouvaille/dsh-fresh-green-skin#readme",
  "bugs": {
    "url": "https://github.com/Kiki-trouvaille/dsh-fresh-green-skin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "wallpaper",
    "skin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.js.tpl",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "screenshot",
    "icon.svg",
    "assets",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
